{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "67js-site",
  "compatibility_date": "2026-10-09",
  "workers_dev": false,
  "routes": [{ "pattern": "67js.codepawl.com", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
