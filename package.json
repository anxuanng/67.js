{
  "name": "@codepawlhq/67js",
  "version": "0.3.0",
  "private": false,
  "type": "module",
  "description": "A browser graphics engine for interactive worlds, animation and cinematic media, with memory-aware CPU/GPU export",
  "license": "MIT",
  "homepage": "https://67js.codepawl.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anxuanng/67.js.git"
  },
  "files": [
    "build",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "ROADMAP.md",
    "THIRD-PARTY-NOTICES.md",
    "skills",
    "docs/gltf.md",
    "docs/verification.md",
    "docs/release-verification.md"
  ],
  "main": "./build/67.module.js",
  "module": "./build/67.module.js",
  "exports": {
    ".": "./build/67.module.js",
    "./addons/model": "./build/model.js",
    "./addons/nature": "./build/nature.js",
    "./addons/film": "./build/film.js",
    "./addons/motion": "./build/motion.js",
    "./addons/canvas2d": "./build/canvas2d.js",
    "./addons/gltf": "./build/gltf.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/prepare-release.mjs && vite build",
    "build:lib": "vite build --config vite.lib.config.js",
    "prepare:release": "node scripts/prepare-release.mjs",
    "prepack": "npm run build:lib",
    "deploy": "node scripts/deploy.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test",
    "smoke": "node scripts/smoke.mjs",
    "smoke:scenes": "node scripts/smoke-scenes.mjs",
    "render": "node scripts/render-media.mjs",
    "score": "node scripts/score.mjs",
    "export:model": "node scripts/export-model.mjs",
    "smoke:package": "node scripts/smoke-package.mjs",
    "smoke:enhancements": "node scripts/smoke-enhancements.mjs",
    "publish:ci": "node scripts/publish-ci.mjs"
  },
  "devDependencies": {
    "gl-matrix": "3.4.4",
    "playwright": "1.64.0",
    "three": "0.186.1",
    "vite": "8.3.4",
    "wrangler": "4.149.0"
  }
}
